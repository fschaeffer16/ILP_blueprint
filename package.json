{
  "name": "ilp",
  "version": "0.2.0",
  "private": true,
  "description": "ILP — Individualized Lesson Planning. A teacher-controlled, AI-powered instructional operating system for K-12 education.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run demo --workspace @ilp/core"
  }
}
